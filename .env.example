# Copiar a .env.local (desarrollo) o configurar en el proveedor (produccion).
# No incluir claves reales en este archivo ni en el repositorio.

# --- Obligatorias ---

# URL del API de Supabase. Local: npx supabase status. Produccion:
# https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave publica (publishable / anon). Es publica por diseno: la proteccion real
# es RLS. En produccion usar la publishable key del proyecto.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origen exacto de la aplicacion. Se usa en los enlaces de recuperacion de
# contrasena y debe coincidir con la Site URL y las Redirect URLs de Supabase
# Auth. Local: http://localhost:3000. Produccion: https://<dominio>
APP_ORIGIN=http://localhost:3000

# Entorno logico: local | test | desarrollo.
# IMPORTANTE: el esquema de validacion no admite "produccion". En produccion
# usar APP_ENV=desarrollo; con local o test se habilitan rutas de desarrollo.
APP_ENV=local

# --- Credencial administrativa (solo servidor) ---

# Clave secreta (service_role / secret key). Necesaria para listar y crear
# usuarios de Auth desde el modulo Usuarios. Nunca usar el prefijo
# NEXT_PUBLIC_* ni exponerla al navegador. En produccion es obligatoria si se
# administran usuarios desde la aplicacion.
SUPABASE_ADMIN_KEY=

# --- Solo desarrollo local ---

# Habilita la creacion idempotente de usuarios demo. Mantener false en produccion.
DEMO_SEED_ENABLED=false

# Contrasena demo local de al menos 12 caracteres. No versionar valores reales.
DEMO_USER_PASSWORD=
